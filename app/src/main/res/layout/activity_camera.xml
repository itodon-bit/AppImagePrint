<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.photoprint.TargetOverlayView
        android:id="@+id/targetOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="#88000000"
        android:padding="8dp"
        android:text="枠の四隅をドラッグして調整できます(枠を小さくすると自動でズームします)"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- 撮影前のプレビュー中に、枠内で認識されている文字をリアルタイムで表示する -->
    <TextView
        android:id="@+id/liveResultText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="180dp"
        android:background="#AA000000"
        android:padding="10dp"
        android:text="「セット」を押すと文字認識を開始します"
        android:textColor="#CCCCCC"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:text="キャンセル" />

    <Button
        android:id="@+id/btnToggleFrame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="枠を隠す" />

    <!-- 押すまでは文字認識(ライブ解析)を行わない。据え置き撮影で対象物を置いてから押す想定 -->
    <Button
        android:id="@+id/btnSet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="110dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:text="セット" />

    <Button
        android:id="@+id/btnCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:paddingStart="48dp"
        android:paddingEnd="48dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:text="撮影" />

</FrameLayout>
